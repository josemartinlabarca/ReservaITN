{
  "name": "reservaitn",
  "private": true,
  "description": "ReservaITN – Sistema de reservas de salas y laboratorios (JBG Tech para ITN)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @reservaitn/db migrar",
    "db:seed": "pnpm --filter @reservaitn/db demo",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
