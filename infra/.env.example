# Opcional. ReservaITN publica PostgreSQL en el puerto 5434 del computador. Solo si ese puerto
# también está ocupado, copia este archivo como infra/.env y elige otro puerto libre; compruébalo con
#   Windows: netstat -ano | findstr :5435      macOS/Linux: lsof -i :5435
# (no debe mostrar nada). Usa el mismo puerto en apps/api/.env (DATABASE_URL).
DB_PUERTO=5435
