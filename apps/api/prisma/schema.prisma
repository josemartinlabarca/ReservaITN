  cuerpo              String
  solicitud_id        String?             @db.Uuid
  reserva_id          String?             @db.Uuid
  orden_trabajo_id    String?             @db.Uuid
  leida_en            DateTime?           @db.Timestamptz(6)
  creado_en           DateTime            @default(now()) @db.Timestamptz(6)
  envio               envio[]
  evento_notificacion evento_notificacion @relation(fields: [evento_codigo], references: [codigo], onDelete: NoAction, onUpdate: NoAction)
