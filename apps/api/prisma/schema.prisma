  reserva             reserva?            @relation(fields: [reserva_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitud           solicitud?          @relation(fields: [solicitud_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario             usuario             @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id, creado_en(sort: Desc)])
