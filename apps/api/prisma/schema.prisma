generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["academico", "auditoria", "comunicacion", "institucion", "mantencion", "reservas", "seguridad"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asignatura {
  id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                    String               @unique
  nombre                    String
  horas_semanales           Int                  @db.SmallInt
  tipo_espacio_requerido_id String?              @db.Uuid
  creado_en                 DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime             @default(now()) @db.Timestamptz(6)
  tipo_espacio              tipo_espacio?        @relation(fields: [tipo_espacio_requerido_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carrera_asignatura        carrera_asignatura[]
  seccion                   seccion[]

  @@schema("academico")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carrera {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo             String               @unique
  nombre             String
  activo             Boolean              @default(true)
  creado_en          DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en     DateTime             @default(now()) @db.Timestamptz(6)
  carrera_asignatura carrera_asignatura[]
  oferta_carrera     oferta_carrera[]
  espacio_carrera    espacio_carrera[]
  usuario_rol        usuario_rol[]

  @@schema("academico")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carrera_asignatura {
  carrera_id    String     @db.Uuid
  asignatura_id String     @db.Uuid
  nivel         Int        @db.SmallInt
  asignatura    asignatura @relation(fields: [asignatura_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carrera       carrera    @relation(fields: [carrera_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([carrera_id, asignatura_id])
  @@index([asignatura_id])
  @@schema("academico")
}

model matricula {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  persona_id        String            @db.Uuid
  oferta_carrera_id String            @db.Uuid
  periodo_id        String            @db.Uuid
  estado            estado_matricula  @default(VIGENTE)
  creado_en         DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime          @default(now()) @db.Timestamptz(6)
  oferta_carrera    oferta_carrera    @relation(fields: [oferta_carrera_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo_academico periodo_academico @relation(fields: [periodo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persona           persona           @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([persona_id, oferta_carrera_id, periodo_id])
  @@index([oferta_carrera_id, periodo_id])
  @@schema("academico")
}

model oferta_carrera {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carrera_id String      @db.Uuid
  sede_id    String      @db.Uuid
  jornada    jornada
  activo     Boolean     @default(true)
  matricula  matricula[]
  carrera    carrera     @relation(fields: [carrera_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sede       sede        @relation(fields: [sede_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seccion    seccion[]

  @@unique([carrera_id, sede_id, jornada])
  @@index([sede_id])
  @@schema("academico")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model periodo_academico {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo       String         @unique
  nombre       String
  fecha_inicio DateTime       @db.Date
  fecha_fin    DateTime       @db.Date
  estado       estado_periodo @default(PLANIFICACION)
  matricula    matricula[]
  seccion      seccion[]
  importacion  importacion[]

  @@schema("academico")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model seccion {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodo_id         String            @db.Uuid
  asignatura_id      String            @db.Uuid
  oferta_carrera_id  String            @db.Uuid
  codigo             String
  docente_persona_id String?           @db.Uuid
  cupo               Int
  inscritos          Int               @default(0)
  creado_en          DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en     DateTime          @default(now()) @db.Timestamptz(6)
  asignatura         asignatura        @relation(fields: [asignatura_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persona            persona?          @relation(fields: [docente_persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oferta_carrera     oferta_carrera    @relation(fields: [oferta_carrera_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo_academico  periodo_academico @relation(fields: [periodo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitud          solicitud[]

  @@unique([periodo_id, asignatura_id, oferta_carrera_id, codigo])
  @@index([docente_persona_id])
  @@index([oferta_carrera_id])
  @@schema("academico")
}

model evento {
  id               BigInt    @id @default(autoincrement())
  esquema          String
  tabla            String
  registro_id      String?
  operacion        operacion
  actor_usuario_id String?   @db.Uuid
  datos_antes      Json?
  datos_despues    Json?
  ocurrido_en      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([actor_usuario_id])
  @@index([esquema, tabla, registro_id])
  @@index([ocurrido_en], map: "evento_por_fecha", type: Brin)
  @@schema("auditoria")
}

model dispositivo {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String     @db.Uuid
  token_push String     @unique
  plataforma plataforma
  ultimo_uso DateTime   @default(now()) @db.Timestamptz(6)
  creado_en  DateTime   @default(now()) @db.Timestamptz(6)
  usuario    usuario    @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id])
  @@schema("comunicacion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model envio {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificacion_id String       @db.Uuid
  canal           canal
  estado          estado_envio @default(PENDIENTE)
  intentos        Int          @default(0) @db.SmallInt
  ultimo_error    String?
  enviado_en      DateTime?    @db.Timestamptz(6)
  creado_en       DateTime     @default(now()) @db.Timestamptz(6)
  notificacion    notificacion @relation(fields: [notificacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([notificacion_id, canal])
  @@schema("comunicacion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evento_notificacion {
  codigo       String         @id
  descripcion  String
  obligatorio  Boolean        @default(false)
  notificacion notificacion[]
