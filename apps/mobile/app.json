{
  "expo": {
    "name": "ReservaITN",
    "slug": "reservaitn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "cl.itn.reservaitn",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "ReservaITN usa la cámara solo para leer el código QR de la sala al hacer check-in."
      }
    },
    "android": {
      "package": "cl.itn.reservaitn",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "ReservaITN usa la cámara solo para leer el código QR de la sala al hacer check-in.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ]
  }
}
